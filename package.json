{
  "name": "text-case-converter",
  "displayName": "Text Case Converter",
  "description": "Convert selected text between 10 case formats: camelCase, PascalCase, snake_case, CONSTANT_CASE, kebab-case, Train-Case, Title Case, Sentence case, lower case, and UPPER CASE.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "vheins",
  "repository": {
    "type": "git",
    "url": "https://github.com/vheins/vscode-text-case-converter"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "text-case-converter.camelCase",
        "title": "To: camelCase",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.pascalCase",
        "title": "To: PascalCase",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.snakeCase",
        "title": "To: snake_case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.constantCase",
        "title": "To: CONSTANT_CASE",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.kebabCase",
        "title": "To: kebab-case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.trainCase",
        "title": "To: Train-Case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.titleCase",
        "title": "To: Title Case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.sentenceCase",
        "title": "To: Sentence case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.lowerCase",
        "title": "To: lower case",
        "category": "Text Case Converter"
      },
      {
        "command": "text-case-converter.upperCase",
        "title": "To: UPPER CASE",
        "category": "Text Case Converter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "text-case-converter.camelCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.pascalCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.snakeCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.constantCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.kebabCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.trainCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.titleCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.sentenceCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.lowerCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        },
        {
          "command": "text-case-converter.upperCase",
          "group": "Text Case Converter",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "yarn run lint",
    "test": "node ./test/runTest.js",
    "test:unit": "mocha \"test/unit/**/*.test.js\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.3.3",
    "@types/vscode": "^1.79.1",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.44.0",
    "glob": "^10.3.1",
    "mocha": "^10.2.0"
  }
}
